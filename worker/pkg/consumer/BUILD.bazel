load("@rules_go//go:def.bzl", "go_library", "go_test")

# The live suite belongs to the hand-written mq_live target below, never to consumer_test:
# it needs a real broker and would otherwise run on every `bazel test //...`. One directive
# per file — gazelle reads only the first path on a line.
# gazelle:exclude live_test.go
# gazelle:exclude manual_test_main_test.go

go_library(
    name = "consumer",
    srcs = [
        "consumer.go",
        "message.go",
    ],
    importpath = "github.com/justinswe/jarvis/worker/pkg/consumer",
    visibility = ["//visibility:public"],
    deps = [
        "//api/jarvis/discord/v1:discord",
        "//mq",
        "@com_github_bwmarrin_discordgo//:discordgo",
        "@com_github_justinswe_std//app",
        "@com_github_justinswe_std//errors",
        "@org_golang_google_protobuf//proto",
        "@org_uber_go_zap//:zap",
    ],
)

go_test(
    name = "consumer_test",
    srcs = ["consumer_test.go"],
    embed = [":consumer"],
    deps = [
        "//api/jarvis/discord/v1:discord",
        "//mq",
        "@com_github_bwmarrin_discordgo//:discordgo",
        "@com_github_justinswe_std//errors",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_golang_google_protobuf//proto",
    ],
)

# The live suite is hand-written: its sources are excluded above, so gazelle would drop the
# target rather than maintain it. `keep` preserves this rule only — the two targets above
# stay managed.
# keep
go_test(
    name = "mq_live",
    size = "large",
    srcs = [
        "consumer_test.go",
        "live_test.go",
        "manual_test_main_test.go",
    ],
    data = ["//:nats_server"],
    embed = [":consumer"],
    tags = ["manual"],
    deps = [
        "//api/jarvis/discord/v1:discord",
        "//mq",
        "@com_github_bwmarrin_discordgo//:discordgo",
        "@com_github_justinswe_std//app",
        "@com_github_justinswe_std//errors",
        "@com_github_nats_io_nats_go//:nats_go",
        "@com_github_nats_io_nats_go//jetstream",
        "@com_github_spf13_cobra//:cobra",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@com_google_cloud_go_pubsub_v2//:pubsub",
        "@com_google_cloud_go_pubsub_v2//apiv1/pubsubpb",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/durationpb",
    ],
)
