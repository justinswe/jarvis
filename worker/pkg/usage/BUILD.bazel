load("@rules_go//go:def.bzl", "go_library", "go_test")

# gazelle:exclude live_test.go manual_test_main_test.go

go_library(
    name = "usage",
    srcs = [
        "keys.go",
        "meter.go",
        "script.go",
        "usage.go",
    ],
    importpath = "github.com/justinswe/jarvis/worker/pkg/usage",
    visibility = ["//:__subpackages__"],
    deps = [
        "//worker/pkg/discord",
        "//worker/pkg/genai",
