load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "jarvis_lib",
    srcs = [
        "config.go",
        "locate.go",
        "main.go",
        "process.go",
        "run.go",
    ],
    importpath = "github.com/justinswe/jarvis/jarvis",
    visibility = ["//visibility:private"],
    deps = [
        "//mq",
        "@com_github_justinswe_std//app",
        "@com_github_justinswe_std//errors",
        "@com_github_spf13_cobra//:cobra",
        "@org_uber_go_zap//:zap",
        "@rules_go//go/runfiles",
    ],
)

go_binary(
    name = "jarvis",
    # Runfiles let the supervisor start its children from `bazel run`. The image
    # is built with include_runfiles = False and ships these same artifacts
    # through additional_binaries and files instead.
    data = [
        "nats.conf",
        "//:nats_server",
        "//:valkey_server_runfiles",
        "//ingestor",
        "//worker",
    ],
    embed = [":jarvis_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "jarvis_test",
    srcs = [
        "jarvis_test.go",
        "locate_test.go",
    ],
    # The resolver tests assert every child is reachable from runfiles. Valkey is
    # absent on macOS by design, so only its skipped-when-disabled path is asserted.
    data = [
        "nats.conf",
        "//:nats_server",
        "//:valkey_server_runfiles",
        "//ingestor",
        "//worker",
    ],
    embed = [":jarvis_lib"],
    deps = [
        "//mq",
        "@com_github_justinswe_std//errors",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

exports_files(["nats.conf"])
